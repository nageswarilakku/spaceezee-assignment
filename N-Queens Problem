def solveNQueens(n):
    cols = set()
    pos_diag = set() # row - col is constant
    neg_diag = set() # row + col is constant
    
    results = []
    board = [['.'] * n for _ in range(n)]

    def backtrack(r):
        if r == n:
            formatted_board = ["".join(row) for row in board]
            results.append(formatted_board)
            return

        for c in range(n):
            # Check safety
            if c in cols or (r - c) in pos_diag or (r + c) in neg_diag:
                continue
            cols.add(c)
            pos_diag.add(r - c)
            neg_diag.add(r + c)
            board[r][c] = "Q"

           
            backtrack(r + 1)
            cols.remove(c)
            pos_diag.remove(r - c)
            neg_diag.remove(r + c)
            board[r][c] = "."
            
    backtrack(0)
    return results
