import heapq

class ListNode:
    def _init_(self, val=0, next=None):
        self.val = val
        self.next = next

def mergeKLists(lists):
    min_heap = []
    unique_id = 0 
    
    for lst in lists:
        if lst:
            heapq.heappush(min_heap, (lst.val, unique_id, lst))
            unique_id += 1
            
    dummy = ListNode(0)
    current = dummy
    
    while min_heap:
        val, _, node = heapq.heappop(min_heap)
        
        current.next = node
        current = current.next
        
        if node.next:
            heapq.heappush(min_heap, (node.next.val, unique_id, node.next))
            unique_id += 1
            
    return dummy.next
